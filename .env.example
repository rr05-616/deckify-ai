# ---------------------------------------------------------------------------
# Frontend (build-time, baked into the bundle by Vite)
# ---------------------------------------------------------------------------

# Leave EMPTY on Vercel. The frontend and API share one domain there, so
# requests to "/api/..." are same-origin. Only set this if you split the
# backend onto a different host.
VITE_API_BASE_URL=

# Base URL of the live x402 payment server (see x402-demo-server/). This one
# is a genuinely separate service — point it at wherever you deployed it.
VITE_X402_SERVER_URL=https://your-x402-server.fly.dev

# ---------------------------------------------------------------------------
# Backend (runtime, read by the serverless function)
# ---------------------------------------------------------------------------

# Injected automatically by the Neon integration on Vercel. When unset, the
# server falls back to server/data/db.json for local development.
# DATABASE_URL=postgres://...

# Always set this. Sessions are signed with it.
SESSION_SECRET=change-me-to-a-long-random-string

# Same-origin on Vercel, so CORS is unnecessary.
CORS_DISABLED=true

# Your production URL, e.g. https://glasspitch.vercel.app
FRONTEND_URL=http://localhost:5173

# Leave UNSET on Vercel — OAuth redirect URIs are derived from the incoming
# request origin, which is already correct on a single domain.
# BACKEND_URL=

# --- Algorand (wallet-connect payment path — Founder upgrade + deck unlock) ---
ALGORAND_NETWORK=testnet
ALGORAND_RECEIVER_ADDRESS=
ALGORAND_ALGOD_URL=
ALGORAND_INDEXER_URL=

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
